{
  "name": "Page name",
  "domain": "hoptackinhdoanh.com",
  "supportedExportFormats": ["docx", "csv"],
  "crawlLimit": 10,
  "concurrencyRequestLimit": 5,
  "dateFormat": "YYYY-MM-DD",
  "selectors": {
    "companyLinks": "div.companyPage-business-list-item-code > h3",
    "companyDetail": {
      "name": ".companyDetailHeader h1",
      "phone": ".companyPhoneReveal",
      "taxCode": ".companyDetail-info-value.taxCode-highlight",
      "address": "div.companyDetailContent > div.companyDetail-info-grid > div:nth-child(2) > div:nth-child(3) > span.companyDetail-info-value",
      "founder": "div.companyDetailContent > div.companyDetail-info-grid > div:nth-child(2) > div:nth-child(2) > span.companyDetail-info-value > strong",
      "startDate": "div.companyDetailContent > div.companyDetail-info-grid > div:nth-child(1) > div:nth-child(5) > span.companyDetail-info-value",
      "email": ".companyEmailReveal",
      "primaryBusiness": ""
    }
  },
  "blackList": {
    "name": {
      "rules": [
        "văn phòng đại diện",
        "Ủy ban",
        "ubnd",
        "công an",
        "massage",
        "ntnn"
      ],
      "validateType": "includes",
      "ignoreCase": true
    },
    "phone": {
      "rules": ["02"],
      "validateType": "startsWith",
      "ignoreCase": true
    }
  }
}
