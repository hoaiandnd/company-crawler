{
  "name": "Page name",
  "domain": "hoptackinhdoanh.com",
  "supportedExportFormats": ["xlsx", "txt"],
  "crawlLimit": 5,
  "concurrencyRequestLimit": 5,
  "dateFormat": "DD/MM/YYYY",
  "selectors": {
    "companyLinks": "",
    "companyDetail": {
      "name": "|#bangdiem > table > thead > tr > th > span",
      "phone": "|#bangdiem > table.table-taxinfo > tbody td[itemprop=address] > span",
      "taxCode": "body > main > div.container.mx-auto.px-4.my-5 > div > main > div > div.mt-2.flex.flex-row.gap-4 > div > ul > li:nth-child(2) > span|#bangdiem > table.table-taxinfo > tbody td[itemprop=taxID] > span",
      "address": "|#bangdiem > table.table-taxinfo > tbody td[itemprop=address] > span",
      "founder": "|#bangdiem > table > tbody > tr:nth-child(6) > td:nth-child(2) > span > a",
      "startDate": "|#bangdiem > table > tbody > tr:nth-child(8) > td:nth-child(2) > span",
      "email": "|#bangdiem > table > tbody > tr:nth-child(11) > td:nth-child(2) > a",
      "primaryBusiness": ""
    }
  },
  "blackList": {
    "name": {
      "rules": ["chi nhánh", "văn phòng đại diện", "Ủy ban", "ubnd", "công an", "massage", "ntnn", "nộp hộ", "phần mềm"],
      "validateType": "includes",
      "ignoreCase": true
    },
    "phone": {
      "rules": ["02"],
      "validateType": "startsWith",
      "ignoreCase": true
    },
    "address": {
      "rules": ["bình dương", "vũng tàu"],
      "validateType": "includes",
      "ignoreCase": true
    }
  },
  "exporterOptions": {
    "txt": {
      "propertyDelimiter": "\n",
      "itemDelimiter": "\n"
    },
    "xlsx": {
      "sheetName": "Sheet 1",
      "columnHeadersMap": {
        "name": "Tên công ty",
        "phone": "Số điện thoại",
        "taxCode": "Mã số thuế",
        "address": "Địa chỉ",
        "founder": "Chủ sở hữu",
        "startDate": "Ngày thành lập",
        "email": "Email",
        "primaryBusiness": "Ngành nghề chính"
      }
    }
  }
}
